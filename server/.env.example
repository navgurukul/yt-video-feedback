# Backend Environment Variables

# Gemini AI API Key (Optional - users can provide their own via frontend)
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database Configuration
PG_HOST=your_database_host
PG_PORT=5432
PG_USER=your_database_user
PG_PASSWORD=your_database_password
PG_DATABASE=your_database_name
PG_SSL=true

# Multi-tenant TEST database (development). Never the same DB as PG_*.
TEST_PG_HOST=your_test_database_host
TEST_PG_PORT=5432
TEST_PG_USER=your_test_database_user
TEST_PG_PASSWORD=your_test_database_password
TEST_PG_DATABASE=your_test_database_name
TEST_PG_SSL=true

# Which database the server uses (see db.js):
#   test          -> TEST_PG_*  (default when TEST_PG_DATABASE is set)
#   prod          -> PG_*       (default on the EC2 server, unchanged)
#   prod-readonly -> PG_* in a read-only session (safe local inspection)
DB_TARGET=test

# Supabase (verifies logins). Falls back to VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY in the root .env
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Encrypts institution Gemini API keys stored in the DB. Random 32+ chars; never change once keys are stored.
ENCRYPTION_KEY=generate-with-node-e-crypto-randomBytes-32-hex

# Allowed frontend origins (comma-separated)
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,https://master.d33dd8pvqtvje3.amplifyapp.com

# Server Configuration
PORT=3001
